<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Plain HTTP is allowed so the app can reach a Radicale server on the
         local network (e.g. http://192.168.1.50:5232). HTTPS servers with
         self-signed certificates are handled separately via the in-app
         "trust self-signed certificates" toggle. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
